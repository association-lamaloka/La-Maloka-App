rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAssociationTeam() {
      return request.auth != null
        && request.auth.token.email == 'association.lamaloka@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Public landing-page content. Editing is reserved for the association's
    // verified Google account.
    match /site_settings/{docId} {
      allow read: if true;
      allow create, update: if isAssociationTeam()
        && !request.resource.data.keys().hasAny(['adminPassword']);
      allow delete: if isAssociationTeam();
    }

    match /gallery/{photoId} {
      allow read: if true;
      allow create, update: if isAssociationTeam()
        && request.resource.data.keys().hasOnly(['id', 'title', 'url', 'description', 'category', 'date'])
        && request.resource.data.id == photoId
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://.*');
      allow delete: if isAssociationTeam();
    }

    // Legacy collections can contain personal or health data. They are closed
    // completely while their remote documents are purged by a project owner.
    match /inscriptions/{document=**} { allow read, write: if false; }
    match /health_forms/{document=**} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
