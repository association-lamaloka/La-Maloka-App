# Optional port for the standalone Express deployment (OVH/container).
PORT=3000

# Server-only Vercel Blob credential. Configure it in Vercel Preview/Production;
# never prefix it with VITE_ and never expose its value to the browser.
BLOB_READ_WRITE_TOKEN=
# Optional upload limit used by /api/media/upload (defaults to 5 MB).
BLOB_MAX_FILE_SIZE_MB=5

# Firebase's public web configuration is stored in firebase-applet-config.json.
# Never place team passwords, service-account keys or webhook secrets here.
