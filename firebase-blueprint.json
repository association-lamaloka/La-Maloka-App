{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firestore-blueprint.json",
  "entities": {
    "site_settings": {
      "title": "SiteSettings",
      "description": "Public landing-page content without credentials or member data",
      "properties": {
        "associationName": { "type": "string" },
        "heroHeadline": { "type": "string" },
        "heroSubheadline": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" }
      }
    },
    "gallery": {
      "title": "GalleryPhoto",
      "description": "Public association photo metadata",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "title", "url"]
    }
  },
  "firestore": {
    "/site_settings/{docId}": { "schema": "#/entities/site_settings" },
    "/gallery/{photoId}": { "schema": "#/entities/gallery" }
  }
}
